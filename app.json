{
  "expo": {
    "name": "Haunts",
    "slug": "haunts",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "haunts",
    "android": {
      "package": "dk.marcrulo.haunts",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.RECEIVE_BOOT_COMPLETED"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dk.marcrulo.haunts"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Haunts notes where you linger so spirits can attach to you. Nothing leaves your phone.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "64d69169-8be7-4738-9637-8017f039859e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/64d69169-8be7-4738-9637-8017f039859e"
    }
  }
}
